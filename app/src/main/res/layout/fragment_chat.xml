                        android:id="@+id/container"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent">
                        <ImageView
                            android:id="@+id/imageView5"
                            android:layout_width="@dimen/dp_26"
                            android:layout_height="@dimen/dp_26"
                            android:layout_marginEnd="@dimen/dp_14"
                            android:src="@drawable/ic_black_camera"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            />

                        <ImageView
                            android:id="@+id/imageView9"
                            android:layout_width="@dimen/dp_26"
                            android:layout_height="@dimen/dp_26"
                            android:layout_marginEnd="@dimen/dp_12"
                            android:src="@drawable/ic_attach_square"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView5"/>
                    </androidx.constraintlayout.widget.ConstraintLayout>-->


                </androidx.constraintlayout.widget.ConstraintLayout>


                <ImageView
                    android:id="@+id/ivImageButton"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_12sdp"
                    android:background="@drawable/ic_tag"
                    android:backgroundTint="@color/grey_hintColor"
                    android:visibility="visible"
                    app:layout_constraintBottom_toBottomOf="@+id/messageSend"
                    app:layout_constraintEnd_toEndOf="@+id/messageSend"
                    app:layout_goneMarginTop="@dimen/_8sdp" />

                <ImageView
                    android:id="@+id/ivSendButton"
                    android:layout_width="@dimen/_40sdp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginEnd="@dimen/_10sdp"
                    android:layout_marginBottom="@dimen/_2sdp"
                    android:src="@drawable/ic_sendmessage"
                    app:layout_constraintBottom_toBottomOf="@+id/messageSend"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@+id/messageSend"
                    app:layout_goneMarginTop="@dimen/_8sdp" />
                <!--   <ImageView
                       android:layout_width="@dimen/dp_35"
                       android:layout_height="@dimen/dp_35"
                       android:layout_marginStart="@dimen/dp_12"
                       android:src="@drawable/ic_send_button"
                       app:layout_constraintBottom_toBottomOf="@+id/ivSendButton"
                       app:layout_constraintEnd_toEndOf="@+id/ivSendButton"
                       app:layout_constraintStart_toEndOf="@+id/edMessage"
                       app:layout_constraintTop_toTopOf="@+id/ivSendButton" />-->

            </androidx.constraintlayout.widget.ConstraintLayout>


        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/_10sdp"
            android:layout_marginTop="@dimen/_5sdp"
            android:background="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clbar">

        </RelativeLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/app_background_color"
            android:elevation="@dimen/_10sdp"
            android:paddingTop="@dimen/_5sdp"
            android:paddingBottom="@dimen/_5sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/IvBack"
                android:layout_width="@dimen/_35sdp"
                android:layout_height="@dimen/_27sdp"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingTop="@dimen/_10sdp"
                android:paddingBottom="@dimen/_9sdp"
                android:src="@drawable/ic_back"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/ivUserProfileImage"
                android:layout_width="@dimen/_27sdp"
                android:layout_height="@dimen/_27sdp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/_20sdp"
                android:layout_marginTop="@dimen/_4sdp"
                android:src="@drawable/ic_greyuser"
                app:layout_constraintStart_toEndOf="@+id/IvBack"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvOtherUserName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/poppins_medium"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                app:layout_constraintStart_toEndOf="@+id/ivUserProfileImage"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/lastSeen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_10sdp"
                android:fontFamily="@font/poppins_semibold"
                android:includeFontPadding="false"
                android:text=""
                android:textColor="@color/white"
                android:textSize="13sp"
                app:layout_constraintStart_toEndOf="@+id/ivUserProfileImage"
                app:layout_constraintTop_toBottomOf="@+id/tvOtherUserName" />

            <ImageView
                android:id="@+id/ivBlueTick"
                android:layout_width="@dimen/_13sdp"
                android:layout_height="@dimen/_13sdp"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/_5sdp"
                android:layout_toEndOf="@id/tvOtherUserName"
                android:src="@drawable/online_green"
                android:visibility="gone"
                app:layout_constraintBottom_toBottomOf="@+id/lastSeen"
                app:layout_constraintStart_toEndOf="@+id/lastSeen"
                app:layout_constraintTop_toBottomOf="@+id/tvOtherUserName" />


        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/ivScrollDown"
            android:layout_width="@dimen/_38sdp"
            android:layout_height="@dimen/_38sdp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:src="@drawable/ic_scroll_down"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/_150sdp"
            android:layout_marginEnd="@dimen/_20sdp"
            app:layout_constraintBottom_toBottomOf="@+id/bottomSheet"
            app:layout_constraintEnd_toEndOf="parent" />
        <include
            android:id="@+id/progressBar"
            android:layout_height="match_parent"
            android:layout_width="match_parent"
            android:visibility="gone"
            layout="@layout/layout_progress_dialog"/>

