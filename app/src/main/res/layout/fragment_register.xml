<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <data>

    </data>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_color"
        tools:context=".authentication.RegisterFragment">



        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/llBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_23sdp"
                android:layout_marginTop="@dimen/_23sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="@dimen/_9sdp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_9sdp"
                    android:text="@string/back"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
        
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/_48sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_30sdp">

                <LinearLayout
                    android:id="@+id/llTopContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginHorizontal="@dimen/_32sdp"
                    android:gravity="center_horizontal"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_115sdp"
                        android:src="@drawable/appicon"
                        />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/welcome"
                        android:textColor="@color/text_color_primary"
                        android:textSize="@dimen/_18sdp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:maxLines="2"
                        android:text="@string/for_your_service"
                        android:textColor="@color/text_color_secondary"
                        android:textSize="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_regular"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/llRegisterContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="visible"
                    android:layout_marginTop="@dimen/_45sdp"
                    android:layout_marginHorizontal="@dimen/_26sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llTopContent">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/your_name"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_38sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/your_name"
                        android:textColor="@color/editext_hint"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:maxLength="18"
                        android:textSize="@dimen/_14sdp"
                        android:imeOptions="actionNext"
                        android:padding="@dimen/_11sdp"
                        android:includeFontPadding="false"
                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                        android:inputType="textPersonName"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView" />

                    <TextView
                        android:id="@+id/tvPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/plate_number"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <EditText
                        android:id="@+id/etPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_38sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/plate_number"
                        android:padding="@dimen/_11sdp"
                        android:singleLine="true"
                        android:maxLines="1"
                        android:textSize="@dimen/_14sdp"
                        android:imeOptions="actionNext"
                        android:src="@drawable/down_arrow"
                        android:includeFontPadding="false"
                        android:textColor="@color/editext_hint"
                        app:layout_constraintBottom_toTopOf="@+id/etName"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="@dimen/_25sdp" />
                    <TextView
                        android:id="@+id/tvContract"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/contract_no"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />
                    <EditText
                        android:id="@+id/etAuftrag"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_38sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/contract_no"
                        android:padding="@dimen/_11sdp"
                        android:singleLine="true"
                        android:inputType="number"
                        android:maxLines="1"
                        android:textSize="@dimen/_14sdp"
                        android:imeOptions="actionDone"
                        android:src="@drawable/down_arrow"
                        android:textColor="@color/editext_hint"
                        android:includeFontPadding="false"
                        app:layout_constraintBottom_toTopOf="@+id/etName"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="@dimen/_24sdp" />

                </LinearLayout>

                <Button
                    android:id="@+id/btNext"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_25sdp"
                    android:background="@drawable/button_background"
                    app:backgroundTint="@color/button_color"
                    android:text="@string/next"
                    android:textAllCaps="false"
                    android:textSize="@dimen/_11sdp"
                    android:textColor="@color/button_text_color"
                    android:fontFamily="@font/poppins_semibold"
                    android:layout_marginTop="@dimen/_55sdp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/llRegisterContent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>

        </ScrollView>

        <include
            android:id="@+id/includeProgress"
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/layout_progress_dialog"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>
