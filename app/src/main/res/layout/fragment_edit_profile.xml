<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/app_background_color"
        tools:context=".UI.settings.EditProfileFragment">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clTopBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent">

            <LinearLayout
                android:id="@+id/llBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/_23sdp"
                android:layout_marginTop="@dimen/_23sdp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="@dimen/_5sdp"
                    android:layout_height="@dimen/_10sdp"
                    android:src="@drawable/ic_back" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/_10sdp"
                    android:text="@string/back"
                    android:textColor="@color/white"
                    android:textSize="@dimen/_12sdp" />
            </LinearLayout>


            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/raleway_bold"
                android:includeFontPadding="false"
                android:text="@string/edit_profile"
                android:layout_marginTop="@dimen/_5sdp"
                android:textColor="@color/white"
                android:textSize="@dimen/_14sdp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/clTopBar"
            app:layout_constraintBottom_toBottomOf="parent">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clRoot"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/_115sdp">


                <androidx.cardview.widget.CardView
                    android:id="@+id/frame_editprofile"
                    android:layout_width="@dimen/_70sdp"
                    android:layout_height="@dimen/_70sdp"
                    android:layout_marginTop="@dimen/_45sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:cardCornerRadius="@dimen/_35sdp"
                    app:cardBackgroundColor="@color/white"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/ivUserProfileImage"
                        android:layout_width="@dimen/_69sdp"
                        android:layout_height="99dp"
                        android:layout_gravity="center"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_greyuser"/>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/_14sdp"
                    android:layout_height="@dimen/_14sdp"
                    app:cardBackgroundColor="@color/white"
                    android:layout_gravity="bottom|end"
                    app:cardCornerRadius="@dimen/_12sdp"
                    android:layout_marginEnd="@dimen/_5sdp"
                    android:layout_marginBottom="@dimen/_5sdp"
                    app:layout_constraintBottom_toBottomOf="@+id/frame_editprofile"
                    app:layout_constraintEnd_toEndOf="@+id/frame_editprofile">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/_12sdp"
                        android:layout_height="@dimen/_12sdp"
                        app:cardCornerRadius="@dimen/_7sdp"
                        android:layout_gravity="center"
                        app:cardBackgroundColor="@color/success_green">
                        <ImageView
                            android:id="@+id/add_icon"
                            android:layout_width="@dimen/_8sdp"
                            android:layout_height="@dimen/_8sdp"
                            android:layout_margin="@dimen/_2sdp"
                            android:layout_gravity="center"
                            android:src="@drawable/add"
                            />
                    </androidx.cardview.widget.CardView>


                </androidx.cardview.widget.CardView>

                <LinearLayout
                    android:id="@+id/llRegisterContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_26sdp"
                    android:layout_marginTop="@dimen/_40sdp"
                    android:orientation="vertical"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/frame_editprofile">

                    <TextView
                        android:id="@+id/tvName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/your_name"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_11sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/etName"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_47sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/first_name"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:imeOptions="actionNext"
                        android:maxLength="18"
                        android:textSize="14sp"

                        android:digits="abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ "
                        android:inputType="textPersonName"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/down_arrow"
                        android:textColor="@color/editext_hint"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/textView" />

                    <TextView
                        android:id="@+id/tvPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/plate_number"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_12sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/etPlate"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_47sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/plate_number"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/down_arrow"
                        android:singleLine="true"
                        android:textSize="14sp"
                        android:imeOptions="actionDone"
                        android:textColor="@color/editext_hint"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintBottom_toTopOf="@+id/etName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        tools:layout_editor_absoluteY="@dimen/_26sdp" />

                    <TextView
                        android:id="@+id/tvAuftrag"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/contract_no"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_12sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <EditText
                        android:id="@+id/etAuftrag"
                        android:layout_width="wrap_content"
                        android:layout_height="@dimen/_47sdp"
                        android:background="@drawable/textfiled_background"
                        android:hint="@string/contract_no"
                        android:includeFontPadding="false"
                        android:maxLines="1"
                        android:textSize="14sp"
                        android:editable="false"
                        android:imeOptions="actionDone"
                        android:singleLine="true"
                        android:padding="@dimen/_12sdp"
                        android:src="@drawable/down_arrow"
                        android:textColor="@color/editext_hint"
                        android:textColorHint="@color/hintColor"
                        app:layout_constraintBottom_toTopOf="@+id/etName"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <TextView
                        android:id="@+id/tvLanguage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginTop="@dimen/_20sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:text="@string/language"
                        android:textColor="@color/editext_hint"
                        android:textSize="@dimen/_12sdp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clLanguage"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_47sdp"
                        android:layout_marginTop="@dimen/_1sdp"
                        android:background="@drawable/textfiled_background"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/tvLanguage1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="@dimen/_12sdp"
                            android:layout_marginEnd="@dimen/_23sdp"
                            android:fontFamily="@font/poppins_regular"
                            android:includeFontPadding="false"
                            android:maxLines="1"
                            android:textColor="@color/editext_hint"
                            android:textSize="@dimen/_11sdp"
                            android:textColorHint="@color/hintColor"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/imageView3"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <ImageView
                            android:id="@+id/imageView3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_22sdp"
                            android:src="@drawable/down_arrow"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />


                    </androidx.constraintlayout.widget.ConstraintLayout>

                    <LinearLayout
                        android:id="@+id/llLanguageList"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/_155sdp"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:background="@drawable/dropdown_layout_background"
                        app:layout_constraintStart_toStartOf="@id/llMainContent"
                        app:layout_constraintBottom_toTopOf="@id/btRegister">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvLanguages"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            tools:listitem="@layout/layout_language_selection"
                            tools:itemCount="3"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btNext"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_40sdp"
                    android:layout_marginHorizontal="@dimen/_22sdp"
                    android:layout_marginTop="@dimen/_32sdp"
                    android:background="@drawable/button_background"
                    android:fontFamily="@font/poppins_semibold"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text_color"
                    android:textSize="@dimen/_12sdp"
                    app:backgroundTint="@color/white"
                    app:layout_constraintTop_toBottomOf="@id/llRegisterContent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </ScrollView>

        <include
            android:id="@+id/includeProgress"
            android:layout_height="0dp"
            android:layout_width="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            layout="@layout/layout_progress_dialog"/>

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>