<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/clStart"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/llTrack1"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:elevation="@dimen/_2sdp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/tvStart"
            app:layout_constraintBottom_toBottomOf="@id/tvStart">
            <ImageView
                android:id="@+id/ivLocationPointer"
                android:layout_width="@dimen/_22sdp"
                android:layout_height="@dimen/_22sdp"
                android:src="@drawable/location_pointer"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <ImageView
            android:id="@+id/trackLineUpper"
            android:layout_width="@dimen/_3sdp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/continuous_track_line"
            app:layout_constraintStart_toStartOf="@id/llTrack1"
            app:layout_constraintEnd_toEndOf="@id/llTrack1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@id/trackLineLower"/>

        <ImageView
            android:id="@+id/trackLineLower"
            android:layout_width="@dimen/_3sdp"
            android:layout_height="0dp"
            android:layout_gravity="center_horizontal"
            android:src="@drawable/continuous_track_line"
            app:layout_constraintStart_toStartOf="@id/llTrack1"
            app:layout_constraintEnd_toEndOf="@id/llTrack1"
            app:layout_constraintTop_toBottomOf="@id/trackLineUpper"
            app:layout_constraintBottom_toBottomOf="parent"/>

        <TextView
            android:id="@+id/tvStart"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_11sdp"
            android:layout_marginBottom="@dimen/_11sdp"
            android:paddingHorizontal="@dimen/_16sdp"
            android:paddingVertical="@dimen/_7sdp"
            android:includeFontPadding="false"
            android:editable="false"
            android:text=""
            android:maxLines="1"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_semibold"
            android:textSize="@dimen/_9sdp"
            android:background="@drawable/inactive_location_background"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/llTrack1"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>