<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

    </data>

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/app_background_color"
        android:orientation="vertical"
        android:paddingStart="@dimen/_1sdp"
        android:paddingVertical="@dimen/_1sdp"
        android:paddingEnd="@dimen/_15sdp">

        <RelativeLayout
            android:id="@+id/optionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/app_background_color">


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/messageLayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/_4sdp"
                >


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clMessage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <TextView
                        android:id="@+id/tvSendTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/poppins_regular"
                        android:includeFontPadding="false"
                        android:paddingStart="@dimen/_7sdp"
                        android:paddingTop="@dimen/_6sdp"
                        android:paddingBottom="@dimen/_6sdp"
                        android:text="@string/time"
                        android:textAlignment="textEnd"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvUnsent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_3sdp"
                        android:layout_marginTop="@dimen/_3sdp"
                        android:fontFamily="@font/poppins_regular"
                        android:paddingStart="@dimen/_6sdp"
                        android:paddingTop="@dimen/_6sdp"
                        android:paddingEnd="@dimen/_10sdp"
                        android:paddingBottom="@dimen/_6sdp"
                        android:text="@string/unsent"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_9sdp"
                        android:textStyle="italic"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintWidth_min="@dimen/_75sdp" />

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:id="@+id/clUserSendMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tvSendTime">

                        <TextView
                            android:id="@+id/tvUserSendMessage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/black_border_background"
                            android:fontFamily="@font/poppins_regular"
                            android:paddingStart="@dimen/_7sdp"
                            android:paddingTop="@dimen/_6sdp"
                            android:paddingEnd="@dimen/_10sdp"
                            android:layout_marginEnd="@dimen/_3sdp"
                            android:paddingBottom="@dimen/_6sdp"
                            android:textColor="@color/white"
                            android:textSize="@dimen/_11sdp"
                            android:includeFontPadding="false"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintWidth_max="@dimen/_155sdp"
                            app:layout_constraintWidth_min="@dimen/_75sdp" />

                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/clSendReply"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/_1sdp"
                            android:background="@drawable/black_border_app_color_background"
                            android:padding="@dimen/_7sdp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:visibility="visible"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            >

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:id="@+id/clReplyMessage"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:background="@drawable/white_boder_background"
                                android:backgroundTint="@color/button_text_color"
                                android:visibility="visible"
                                app:layout_constraintEnd_toEndOf="@+id/tvReplySendMsg"
                                app:layout_constraintStart_toStartOf="@+id/tvReplySendMsg"
                                app:layout_constraintTop_toTopOf="parent">

                                <ImageView
                                    android:id="@+id/replyClose"
                                    android:layout_width="@dimen/_20sdp"
                                    android:layout_height="@dimen/_20sdp"
                                    android:layout_marginEnd="@dimen/_7sdp"
                                    android:backgroundTint="@color/white"
                                    android:scaleType="centerCrop"
                                    android:visibility="gone"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/tvYou"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:drawablePadding="@dimen/_7sdp"
                                    android:fontFamily="@font/poppins_medium"
                                    android:includeFontPadding="false"
                                    android:paddingHorizontal="@dimen/_7sdp"
                                    android:paddingVertical="@dimen/_2sdp"
                                    android:text="@string/you"
                                    android:textColor="@color/white"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent" />

                                <TextView
                                    android:id="@+id/tvReplyMsg"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_marginEnd="@dimen/_4sdp"
                                    android:drawablePadding="@dimen/_7sdp"
                                    android:fontFamily="@font/poppins_regular"
                                    android:textSize="@dimen/_10sdp"
                                    android:includeFontPadding="false"
                                    android:maxLines="1"
                                    android:paddingStart="@dimen/_7sdp"
                                    android:paddingVertical="@dimen/_2sdp"
                                    android:textColor="@color/white"
                                    android:ellipsize="end"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toStartOf="@+id/replyClose"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toBottomOf="@+id/tvYou"
                                 />
                            </androidx.constraintlayout.widget.ConstraintLayout>

                            <TextView
                                android:id="@+id/tvReplySendMsg"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:includeFontPadding="false"
                                android:paddingStart="@dimen/_7sdp"
                                android:paddingTop="@dimen/_6sdp"
                                android:paddingEnd="@dimen/_10sdp"
                                android:paddingBottom="@dimen/_6sdp"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_11sdp"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/clReplyMessage"
                                app:layout_constraintWidth_max="@dimen/_142sdp"
                                app:layout_constraintWidth_min="@dimen/_75sdp" />



                        </androidx.constraintlayout.widget.ConstraintLayout>


                    </androidx.constraintlayout.widget.ConstraintLayout>


                    <ImageView
                        android:id="@+id/dotedLine"
                        android:layout_width="@dimen/_18sdp"
                        android:layout_height="@dimen/_18sdp"
                        android:layout_marginHorizontal="@dimen/_4sdp"
                        android:layout_marginEnd="@dimen/_6sdp"
                        android:paddingHorizontal="@dimen/_4sdp"
                        android:src="@drawable/dot_line"
                        app:layout_constraintBottom_toBottomOf="@+id/clUserSendMessage"
                        app:layout_constraintEnd_toStartOf="@+id/clUserSendMessage"
                        app:layout_constraintTop_toTopOf="@+id/clUserSendMessage" />

                    <LinearLayout
                        android:id="@+id/clSentMessageDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_7sdp"
                        android:background="@drawable/white_boder_background"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/_12sdp"
                        android:paddingVertical="@dimen/_8sdp"
                        android:visibility="gone"
                        app:layout_constraintBottom_toBottomOf="@+id/dotedLine"
                        app:layout_constraintEnd_toStartOf="@+id/dotedLine"
                        app:layout_constraintStart_toEndOf="@+id/dotedLine"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/dotedLine">

                        <LinearLayout
                            android:id="@+id/llReply"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_5sdp"
                                android:src="@drawable/ic_reply" />

                            <TextView
                                android:id="@+id/tvSent"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/reply"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_9sdp"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llCopy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/_5sdp"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_4sdp"
                                android:background="@drawable/ic_copy"
                                android:backgroundTint="@color/white" />

                            <TextView
                                android:id="@+id/tvSentDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/copy"
                                android:includeFontPadding="false"
                                android:textAlignment="textEnd"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_9sdp"
                                android:visibility="visible"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvSent" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/llDelete"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="@dimen/_12sdp"
                                android:layout_height="@dimen/_12sdp"
                                android:layout_gravity="center_vertical"
                                android:layout_marginEnd="@dimen/_4sdp"
                                android:src="@drawable/ic_delete" />

                            <TextView
                                android:id="@+id/tvSentTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/poppins_regular"
                                android:text="@string/delete"
                                android:includeFontPadding="false"
                                android:textColor="@color/white"
                                android:textSize="@dimen/_9sdp"
                                android:visibility="visible"
                                app:layout_constraintBottom_toBottomOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toBottomOf="@+id/tvSentDate" />
                        </LinearLayout>


                    </LinearLayout>


                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>


        </RelativeLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clDeleteMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/black_border_background"
            android:visibility="gone"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/_1sdp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:id="@+id/replyCloses"
                android:layout_width="@dimen/_24sdp"
                android:layout_height="@dimen/_24sdp"
                android:layout_margin="@dimen/_4sdp"
                android:scaleType="centerCrop"
                android:padding="@dimen/_3sdp"
                android:src="@drawable/baseline_block_flipped_24"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <TextView
                android:id="@+id/tvDeleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/_7sdp"
                android:fontFamily="@font/poppins_medium"
                android:includeFontPadding="false"
                android:layout_marginStart="@dimen/_5sdp"
                android:paddingHorizontal="@dimen/_7sdp"
                android:paddingVertical="@dimen/_4sdp"
                android:textColor="@color/white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/replyCloses"
                app:layout_constraintTop_toTopOf="parent" />


        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
</layout>