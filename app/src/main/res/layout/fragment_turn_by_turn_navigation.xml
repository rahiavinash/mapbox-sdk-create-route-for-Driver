            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/clRoutes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:visibility="gone"
                app:layout_constraintBottom_toTopOf="@+id/tripProgressCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <androidx.coordinatorlayout.widget.CoordinatorLayout
                    android:id="@+id/coordinatorLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:layout_constraintBottom_toTopOf="@+id/llButtons"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <LinearLayout
                        android:id="@+id/bottomSheet"
                        android:layout_width="match_parent"
                        android:layout_height="35dp"
                        android:background="@drawable/stops_background_upper"
                        android:elevation="8dp"
                        android:orientation="vertical"
                        android:paddingStart="22dp"

                        android:paddingEnd="12dp">
                        <androidx.constraintlayout.widget.ConstraintLayout
                            android:id="@+id/straightLine"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="12dp">

                            <ImageView
                                android:layout_width="112dp"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center_horizontal"
                                android:layout_marginBottom="10dp"
                                android:src="@drawable/straight_loine"
                                app:tint="@color/button_color"
                                app:layout_constraintStart_toStartOf="parent"
                                app:layout_constraintEnd_toEndOf="parent"
                                app:layout_constraintTop_toTopOf="parent"
                                app:layout_constraintBottom_toBottomOf="parent"/>

                        </androidx.constraintlayout.widget.ConstraintLayout>

                        <androidx.appcompat.widget.LinearLayoutCompat
                            android:id="@+id/llStops"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:alpha="1"
                            android:visibility="visible">

                            <androidx.constraintlayout.widget.ConstraintLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rvStops"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:scrollbars="vertical"
                                    android:visibility="visible"
                                    app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
                                    app:layout_constraintBottom_toBottomOf="parent"
                                    app:layout_constraintEnd_toEndOf="parent"
                                    app:layout_constraintHeight_max="@dimen/_270sdp"
                                    app:layout_constraintStart_toStartOf="parent"
                                    app:layout_constraintTop_toTopOf="parent"
                                    tools:itemCount="2"
                                    tools:listitem="@layout/layout_stop_item" />
                            </androidx.constraintlayout.widget.ConstraintLayout>
                        </androidx.appcompat.widget.LinearLayoutCompat>

                    </LinearLayout>

                </androidx.coordinatorlayout.widget.CoordinatorLayout>

                <LinearLayout
                    android:id="@+id/llButtons"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="2dp"
                    android:background="@drawable/dark_shadow_stops_lower"
                    android:orientation="horizontal"
                    android:paddingVertical="15dp"
                    android:paddingStart="22dp"

                    android:paddingEnd="12dp"
                    android:visibility="visible"
                    android:weightSum="5"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <Button
                        android:id="@+id/btBack"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:layout_weight="2"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:background="@drawable/black_border_button"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingTop="5dp"
                        android:text="@string/back"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <Button
                        android:id="@+id/btNext"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="12dp"
                        android:layout_weight="3"
                        android:layout_marginBottom="@dimen/_10sdp"
                        android:background="@drawable/button_background"
                        android:fontFamily="@font/poppins_semibold"
                        android:paddingTop="5dp"
                        android:text="@string/nextStop"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="14sp"
                        app:backgroundTint="@color/button_color"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent" />

                    <!--                    <Button-->
                    <!--                        android:id="@+id/btNextLocation"-->
                    <!--                        android:layout_width="0dp"-->
                    <!--                        android:layout_height="45dp"-->
                    <!--                        android:layout_marginHorizontal="@dimen/_15sdp"-->
                    <!--                        android:layout_marginVertical="@dimen/_5sdp"-->
                    <!--                        android:layout_weight="5"-->
                    <!--                        android:background="@drawable/button_background"-->
                    <!--                        android:fontFamily="@font/poppins_semibold"-->
                    <!--                        android:paddingTop="5dp"-->
                    <!--                        android:textAllCaps="false"-->
                    <!--                        android:textColor="@color/white"-->
                    <!--                        android:textSize="16sp"-->
                    <!--                        android:visibility="visible"-->
                    <!--                        app:backgroundTint="@color/button_color"-->
                    <!--                        app:layout_constraintEnd_toEndOf="parent"-->
                    <!--                        app:layout_constraintStart_toEndOf="@+id/btBackDummyView"-->
                    <!--                        app:layout_constraintTop_toTopOf="parent" />-->

                </LinearLayout>


            </androidx.constraintlayout.widget.ConstraintLayout>



            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/llButtonMainMap"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginBottom="@dimen/_2sdp"
                android:background="@drawable/dark_shadow_card_background"
                android:gravity="center_horizontal"
                android:orientation="horizontal"
                android:visibility="visible"
                android:weightSum="4"
                app:layout_constraintBottom_toTopOf="@+id/tripProgressCard"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <Button
                    android:id="@+id/btBackMainMap"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:layout_marginStart="@dimen/_15sdp"
                    android:layout_marginEnd="@dimen/_80sdp"
                    android:layout_weight="2"
                    android:background="@drawable/white_border_background"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingHorizontal="@dimen/_30sdp"
                    android:paddingTop="5dp"
                    android:text="@string/back"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    android:visibility="gone"
                    app:backgroundTint="@color/black"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <View
                    android:id="@+id/btBackDummyView"
                    android:layout_width="@dimen/_50sdp"
                    android:layout_height="40dp"
                    android:layout_marginVertical="@dimen/_5sdp"
                    android:layout_weight="2"
                    android:background="@color/transparent"
                    android:paddingTop="5dp"

                    android:visibility="gone"
                    app:backgroundTint="@color/transparent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btBackMainMap" />

                <Button
                    android:id="@+id/btNextLocation"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/_36sdp"
                    android:layout_marginHorizontal="@dimen/_18sdp"
                    android:layout_marginVertical="@dimen/_18sdp"
                    android:layout_marginBottom="@dimen/_18sdp"
                    android:layout_weight="2"
                    android:background="@drawable/button_background"
                    android:fontFamily="@font/poppins_semibold"
                    android:paddingTop="5dp"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="16sp"
                    android:visibility="visible"
                    app:backgroundTint="@color/button_color"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@+id/btBackDummyView"
                    app:layout_constraintTop_toTopOf="parent" />

                <LinearLayout
                    android:id="@+id/llStartNavigation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:elevation="10dp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    app:layout_constraintBottom_toBottomOf="@id/btNextLocation"
                    app:layout_constraintEnd_toEndOf="@id/btNextLocation"
                    app:layout_constraintStart_toStartOf="@id/btNextLocation"
                    app:layout_constraintTop_toTopOf="@id/btNextLocation">

                    <ImageView
                        android:id="@+id/ivStart"
                        android:layout_width="16dp"
                        android:layout_height="17dp"
                        android:layout_marginEnd="10dp"
                        android:elevation="10dp"
                        android:src="@drawable/ic_nav"
                        app:tint="@color/white" />

                    <TextView
                        android:id="@+id/tvStartNavigation"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:elevation="10dp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:text="@string/start_nav"
                        android:textAllCaps="false"
                        android:textColor="@color/white"
                        android:textSize="@dimen/_14sdp" />

                </LinearLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/customManeuver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/_15sdp"
                android:layout_marginTop="@dimen/_25sdp"
                android:background="@drawable/dark_shadow_card_background"
                android:elevation="@dimen/_50sdp"
                android:outlineAmbientShadowColor="@color/black"
                android:shadowColor="@color/black"
                android:shadowDy="2"
                android:shadowRadius="5"
                android:visibility="gone"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/_15sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginVertical="@dimen/_15sdp"
                    android:background="@color/white"
                    android:layout_marginHorizontal="@dimen/_2sdp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <ImageView
                        android:id="@+id/ivTurnColor"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_marginStart="@dimen/_12sdp"
                        android:fontFamily="@font/poppins_bold"
                        android:paddingTop="5dp"
                        android:text="@string/show_route"
                        android:textAllCaps="false"
                        android:textColor="@color/button_text_color"
                        android:textSize="13sp"
                        android:visibility="visible"
                        app:backgroundTint="@color/card_notification_color2"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDistance"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:fontFamily="@font/poppins_semibold"
                        android:includeFontPadding="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_14sdp"
                        app:layout_constraintEnd_toStartOf="@+id/tvTime"
                        app:layout_constraintStart_toEndOf="@+id/ivTurnColor"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tvDestinationName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/_10sdp"
                        android:layout_marginEnd="@dimen/_5sdp"
                        android:includeFontPadding="false"
                        android:textColor="@color/greyColor"
                        android:textSize="@dimen/_14sdp"

                        app:layout_constraintEnd_toStartOf="@+id/tvTime"
                        app:layout_constraintStart_toEndOf="@+id/ivTurnColor"
                        app:layout_constraintTop_toBottomOf="@+id/tvDistance" />

                    <TextView
                        android:id="@+id/tvTime"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/_18sdp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="@color/button_color"
                        android:textSize="@dimen/_16sdp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>


        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/contentLoadingProgressBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/transparent_2"
            android:visibility="gone">

            <ProgressBar
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="@dimen/_60sdp"
                android:layout_height="@dimen/_60sdp"
                android:layout_gravity="center"
                android:indeterminate="true"
                android:indeterminateTint="@color/app_background_color"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:id="@+id/clStartPoint"
            android:visibility="gone"
            android:background="@color/transparent_3"
            app:layout_constraintBottom_toBottomOf="@+id/constraintLayout2"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                app:layout_constraintBottom_toBottomOf="parent"
                android:paddingVertical="@dimen/_18sdp"

                android:background="@drawable/message_background"
                android:backgroundTint="#E50B0C11"
                android:layout_marginHorizontal="@dimen/_12sdp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/clDialog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/cvDialogImage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:cardCornerRadius="@dimen/_8sdp"
                        app:cardBackgroundColor="@color/transparent"
                        android:visibility="gone"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent">

                        <ImageView
                            android:id="@+id/startPointImage"
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/_160sdp"
                            android:scaleType="centerCrop"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />
                    </androidx.cardview.widget.CardView>


                    <ImageView
                        android:id="@+id/ivDialog"
                        android:layout_width="@dimen/_30sdp"
                        android:layout_height="@dimen/_30sdp"
                        android:src="@drawable/des_reached"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />


                </androidx.constraintlayout.widget.ConstraintLayout>

                <TextView
                    android:id="@+id/tv_main_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:textColor="@android:color/white"
                    android:textSize="@dimen/_17sdp"
                    android:textStyle="bold"
                    android:visibility="visible"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/clDialog"  />


                <TextView
                    android:id="@+id/tvsDescription"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:maxLines="16"
                    android:textSize="14sp"
                    android:overScrollMode="always"
                    android:textColor="@color/greyColor"
                    android:includeFontPadding="false"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:text="@string/you_are_reached_your_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/tv_main_title" />

                <TextView
                    android:id="@+id/tvText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_semibold"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:textColor="@color/dialog_text_color_secondary"
                    android:textSize="@dimen/_1sdp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvsDescription" />

                <LinearLayout
                    android:id="@+id/llButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_25sdp"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:visibility="gone"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_bias="1.0"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvText">

                    <Button
                        android:id="@+id/btDialogLeftSide"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_37sdp"
                        android:layout_marginEnd="@dimen/_12sdp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background"
                        android:fontFamily="@font/poppins_semibold"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:backgroundTint="@color/white" />

                    <Button
                        android:id="@+id/btDialogRightSide"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/_37sdp"
                        android:layout_marginStart="@dimen/_15sdp"
                        android:layout_weight="1"
                        android:background="@drawable/button_background"
                        android:fontFamily="@font/poppins_semibold"
                        android:textAllCaps="false"
                        android:textColor="@color/black"
                        android:textSize="@dimen/_11sdp"
                        app:backgroundTint="@color/white" />
                </LinearLayout>

                <Button
                    android:id="@+id/btDialog"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/_8sdp"
                    android:background="@drawable/button_background"
                    android:textColor="@color/button_text_color"
                    android:textSize="@dimen/_11sdp"
                    android:layout_marginHorizontal="@dimen/_20sdp"
                    android:fontFamily="@font/poppins_semibold"
                    android:visibility="visible"
                    android:includeFontPadding="false"
                    android:inputType="textCapCharacters"
                    android:text="@string/close"
                    app:backgroundTint="@color/white"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvText" />
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <include
            android:id="@+id/incDestinationReachedPopoUp"
            layout="@layout/dialog_off_route"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />


        <include
            android:id="@+id/newIncReachedPopUp"
            layout="@layout/reached_at_destination_layout"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            />

    </androidx.constraintlayout.widget.ConstraintLayout>
</layout>