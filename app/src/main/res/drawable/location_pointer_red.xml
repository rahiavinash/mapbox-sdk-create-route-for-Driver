<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer Circle (28dp diameter) -->
    <item>
        <shape android:shape="oval">
            <size
                android:width="28dp"
                android:height="28dp" />
            <solid android:color="@color/grey_border_color" />
        </shape>
    </item>

    <item
        android:bottom="9dp"
        android:left="9dp"
        android:right="9dp"
        android:top="9dp">
        <shape android:shape="oval">
            <size
                android:width="10dp"
                android:height="10dp" />
            <solid android:color="@color/red_location_pointer" />
        </shape>
    </item>
</layer-list>